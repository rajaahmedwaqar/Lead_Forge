VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Public URL of the deployed site (used for canonical links, sitemap and social previews)
VITE_SITE_URL=https://your-domain.example
# Only change if you set ADMIN_EMAIL_DOMAIN on the bootstrap-admin function
VITE_ADMIN_EMAIL_DOMAIN=admin.leadforge.invalid
# The n8n webhook URL is NOT a frontend variable any more. Set it as a Supabase secret
# (N8N_WEBHOOK_URL) or in the Admin panel > Settings.
